{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sequence Diagram",
  "scopeName": "source.seq",
  "fileTypes": ["seq"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#block-keywords" },
    { "include": "#declaration-keywords" },
    { "include": "#found-message" },
    { "include": "#lost-message" },
    { "include": "#arrow-message" },
    { "include": "#self-call" },
    { "include": "#quoted-string" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.seq",
      "match": "//.*$"
    },

    "block-keywords": {
      "patterns": [
        {
          "comment": "block openers with optional label",
          "match": "^\\s*(opt|loop|break|critical|alt|par|group|else|and|section)\\b(.*)?$",
          "captures": {
            "1": { "name": "keyword.control.seq" },
            "2": { "name": "string.unquoted.label.seq" }
          }
        },
        {
          "comment": "block closer: end / end note",
          "match": "^\\s*(end note|end)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.seq" }
          }
        }
      ]
    },

    "declaration-keywords": {
      "patterns": [
        {
          "comment": "title: <text> [width N] [height N] (new syntax)",
          "match": "^\\s*(title)(\\s+(?:width|height)\\s+[0-9]+)*\\s*:\\s*(.+)$",
          "captures": {
            "1": { "name": "keyword.other.seq" },
            "3": { "name": "entity.name.section.seq" }
          }
        },
        {
          "comment": "title \"text\" [width N] [height N] (old syntax)",
          "match": "^\\s*(title)\\s+(\"[^\"]*\")((?:\\s+(?:width|height)\\s+[0-9]+)*)$",
          "captures": {
            "1": { "name": "keyword.other.seq" },
            "2": { "name": "entity.name.section.seq" },
            "3": { "name": "constant.numeric.seq" }
          }
        },
        {
          "comment": "participant NAME [width N] [spacing N] [: text] (new syntax)",
          "match": "^\\s*(participant)\\s+([A-Za-z0-9_]+)((?:\\s+(?:width|spacing)\\s+[0-9]+)*)(\\s*:\\s*(.+))?$",
          "captures": {
            "1": { "name": "keyword.other.seq" },
            "2": { "name": "entity.name.type.seq" },
            "3": { "name": "constant.numeric.seq" },
            "5": { "name": "string.unquoted.label.seq" }
          }
        },
        {
          "comment": "participant \"Display Name\" [as ALIAS] (old syntax, quoted name)",
          "match": "^\\s*(participant)\\s+(\"[^\"]*\")((?:\\s+(?:width|spacing)\\s+[0-9]+)*)(\\s+as\\s+([A-Za-z0-9_]+))?$",
          "captures": {
            "1": { "name": "keyword.other.seq" },
            "2": { "name": "string.unquoted.label.seq" },
            "3": { "name": "constant.numeric.seq" },
            "4": { "name": "keyword.other.seq" },
            "5": { "name": "entity.name.type.seq" }
          }
        },
        {
          "comment": "participant NAME as ALIAS [spacing N] (old syntax, unquoted name with alias)",
          "match": "^\\s*(participant)\\s+([A-Za-z0-9_]+)((?:\\s+(?:width|spacing)\\s+[0-9]+)*)\\s+(as)\\s+([A-Za-z0-9_]+)$",
          "captures": {
            "1": { "name": "keyword.other.seq" },
            "2": { "name": "string.unquoted.label.seq" },
            "3": { "name": "constant.numeric.seq" },
            "4": { "name": "keyword.other.seq" },
            "5": { "name": "entity.name.type.seq" }
          }
        },
        {
          "comment": "activate / deactivate",
          "match": "^\\s*(activate|deactivate)(\\s+[A-Za-z0-9_]+)+$",
          "captures": {
            "1": { "name": "keyword.other.seq" }
          }
        },
        {
          "comment": "note on NAME [...]: text (new syntax, inline)",
          "match": "^\\s*(note on)\\s+([A-Za-z0-9_]+)((?:\\s+(?:dx|dy|width|height)\\s+-?[0-9]+)*)\\s*:\\s*(.+)$",
          "captures": {
            "1": { "name": "keyword.other.seq" },
            "2": { "name": "entity.name.type.seq" },
            "3": { "name": "constant.numeric.seq" },
            "4": { "name": "string.unquoted.label.seq" }
          }
        },
        {
          "comment": "note on NAME [...] (old syntax, block form — no colon)",
          "match": "^\\s*(note on)\\s+([A-Za-z0-9_]+)((?:\\s+(?:dx|dy|width|height)\\s+-?[0-9]+)*)$",
          "captures": {
            "1": { "name": "keyword.other.seq" },
            "2": { "name": "entity.name.type.seq" },
            "3": { "name": "constant.numeric.seq" }
          }
        },
        {
          "comment": "extend frame / frame extend (new and old syntax)",
          "match": "^\\s*(extend frame|frame extend)\\s+(-?[0-9]+)$",
          "captures": {
            "1": { "name": "keyword.other.seq" },
            "2": { "name": "constant.numeric.seq" }
          }
        },
        {
          "comment": "vertical offset",
          "match": "^\\s*(vertical offset)\\s+(-?[0-9]+)$",
          "captures": {
            "1": { "name": "keyword.other.seq" },
            "2": { "name": "constant.numeric.seq" }
          }
        }
      ]
    },

    "found-message": {
      "comment": "found left/right [offset] -> ReceiverNAME [: label]",
      "match": "^\\s*(found)\\s+(left|right)(\\s+[0-9]+)?\\s+(--?>?>?[+\\-|]?)\\s+([A-Za-z0-9_]+)(\\s*:\\s*(.+))?$",
      "captures": {
        "1": { "name": "keyword.other.seq" },
        "2": { "name": "keyword.other.seq" },
        "3": { "name": "constant.numeric.seq" },
        "4": { "name": "keyword.operator.arrow.seq" },
        "5": { "name": "entity.name.type.seq" },
        "7": { "name": "string.unquoted.label.seq" }
      }
    },

    "lost-message": {
      "comment": "SenderNAME -> lost left/right [offset] [: label]",
      "match": "^\\s*([A-Za-z0-9_]+)\\s+(--?>?>?[+\\-|]?)\\s+(lost)\\s+(left|right)(\\s+[0-9]+)?(\\s*:\\s*(.+))?$",
      "captures": {
        "1": { "name": "entity.name.type.seq" },
        "2": { "name": "keyword.operator.arrow.seq" },
        "3": { "name": "keyword.other.seq" },
        "4": { "name": "keyword.other.seq" },
        "5": { "name": "constant.numeric.seq" },
        "7": { "name": "string.unquoted.label.seq" }
      }
    },

    "arrow-message": {
      "comment": "SenderNAME -->> ReceiverNAME [: label]",
      "match": "^\\s*([A-Za-z0-9_]+)\\s+(--?>?>?[+\\-|]?)\\s+([A-Za-z0-9_]+)(\\s*:\\s*(.+))?$",
      "captures": {
        "1": { "name": "entity.name.type.seq" },
        "2": { "name": "keyword.operator.arrow.seq" },
        "3": { "name": "entity.name.type.seq" },
        "5": { "name": "string.unquoted.label.seq" }
      }
    },

    "self-call": {
      "comment": "NAME : label  (self-call, no arrow)",
      "match": "^\\s*([A-Za-z0-9_]+)\\s*:\\s*(.+)$",
      "captures": {
        "1": { "name": "entity.name.type.seq" },
        "2": { "name": "string.unquoted.label.seq" }
      }
    },

    "quoted-string": {
      "name": "string.quoted.double.seq",
      "match": "\"[^\"\\n]*\""
    },

    "number": {
      "name": "constant.numeric.seq",
      "match": "\\b-?[0-9]+\\b"
    }
  }
}
